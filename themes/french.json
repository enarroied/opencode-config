        "900": "#f3f6fc"
      },
      "accent": "$hue.red",
      "interactive": "$hue.blue",
      "neutral": "$hue.gray"
    },
    "text": {
      "action": {
        "primary": {
          "$focused": "$hue.neutral.100"
        },
        "destructive": {
          "base": "$hue.red.200"
        }
      },
      "feedback": {
        "warning": {
          "base": "$hue.orange.100"
        }
      }
    },
    "border": {
      "base": "#b9c4de"
    },
    "scrollbar": {
      "base": "#8c97b5"
    },
    "diff": {
      "text": {
        "added": "#1f4fb5",
        "context": "#4a5678",
        "hunkHeader": "#4a5678"
      },
      "background": {
        "added": "#e4edfc",
        "removed": "#fde4e6"
      },
      "highlight": {
        "added": "#5a85e0",
        "removed": "#d23a48"
      },
      "lineNumber": {
        "text": "#4a5678",
        "background": {
          "added": "#d3e0f7",
          "removed": "#f9d3d7"
        }
      }
    },
    "syntax": {
      "number": "$hue.orange.100",
      "type": "$hue.blue.200"
    },
    "markdown": {
      "blockQuote": "$hue.blue.200",
      "emphasis": "$hue.blue.200",
      "strong": "$hue.red.200"
    }
  },
  "dark": {
    "hue": {
      "gray": {
        "100": "#ffffff",
        "200": "#f2f4fa",
        "300": "#c9d0e3",
        "400": "#8c97b5",
        "500": "#4a5678",
        "600": "#1f2a4d",
        "700": "#142040",
