{
  "$schema": "https://opencode.ai/theme.json",
  "base": {
    "categorical": [
      "blue",
      "red",
      "cyan",
      "purple",
      "orange"
    ],
    "text": {
      "base": "$hue.neutral.200",
      "muted": "$hue.neutral.400",
      "action": {
        "primary": {
          "base": "$text.base",
          "$focused": "$hue.neutral.100",
          "$selected": "$hue.interactive.100",
          "$disabled": "$hue.neutral.400"
        },
        "secondary": {
          "base": "$text.muted",
          "$hovered": "$text.base"
        },
        "destructive": {
          "base": "$hue.accent.200",
          "$disabled": "$hue.neutral.400"
        }
      },
      "formfield": {
        "base": "$hue.neutral.200",
        "$hovered": "$hue.interactive.100",
        "$focused": "$hue.interactive.100",
        "$pressed": "$hue.interactive.100",
        "$selected": "$hue.interactive.100",
        "$disabled": "$hue.neutral.400"
      },
      "feedback": {
        "error": {
          "base": "$hue.red.200"
        },
        "warning": {
          "base": "#f5c451"
        },
        "success": {
          "base": "$hue.cyan.200"
        },
        "info": {
          "base": "$hue.blue.100"
        }
      }
    },
    "background": {
      "base": "$hue.neutral.800",
      "raised": {
        "base": "$hue.neutral.700",
        "high": "$hue.neutral.600",
        "max": "$hue.neutral.500"
      },
      "action": {
        "primary": {
          "base": "transparent",
          "$hovered": "$hue.neutral.700",
          "$focused": "$hue.interactive.700",
          "$selected": "transparent"
        },
        "secondary": {
          "base": "transparent"
        },
        "destructive": {
          "base": "$hue.red.700"
        }
      },
      "formfield": {
        "base": "$background.base"
      },
      "feedback": {
        "error": {
          "base": "$background.base"
        },
        "warning": {
          "base": "$background.base"
        },
        "success": {
          "base": "$background.base"
        },
        "info": {
          "base": "$background.base"
        }
      }
    },
    "border": {
      "base": "#2c3d6b"
    },
    "scrollbar": {
      "base": "#3d5288"
    },
    "diff": {
      "text": {
        "added": "#8fb8ff",
        "removed": "#ff7a85",
        "context": "#8c97b5",
        "hunkHeader": "#8c97b5"
      },
      "background": {
        "added": "#0f2a4f",
        "removed": "#3d0d16",
        "context": "$hue.neutral.700"
      },
      "highlight": {
        "added": "$hue.blue.300",
        "removed": "$hue.red.300"
      },
      "lineNumber": {
        "text": "#8c97b5",
        "background": {
          "added": "#0b2040",
          "removed": "#2e0b12"
        }
      }
    },
    "syntax": {
      "comment": "$hue.neutral.400",
      "keyword": "$hue.accent.200",
      "function": "$hue.interactive.100",
      "variable": "$hue.cyan.100",
      "string": "$hue.cyan.200",
      "number": "#f5c451",
      "type": "$hue.blue.100",
      "operator": "$hue.red.100",
      "punctuation": "$hue.neutral.200"
    },
    "markdown": {
      "text": "$hue.neutral.200",
      "heading": "$hue.accent.200",
      "link": "$hue.interactive.100",
      "linkText": "$hue.cyan.200",
      "code": "$hue.cyan.200",
      "blockQuote": "$hue.blue.100",
      "emphasis": "$hue.blue.100",
      "strong": "$hue.red.100",
      "horizontalRule": "$hue.neutral.400",
      "listItem": "$hue.interactive.100",
      "listEnumeration": "$hue.cyan.200",
      "image": "$hue.interactive.100",
      "imageText": "$hue.cyan.200",
      "codeBlock": "$hue.neutral.200"
    },
    "@dialog": {
      "background": {
        "base": "$background.raised.base",
        "action": {
          "primary": {
            "$hovered": "$background.raised.high"
          }
        }
      }
    }
  },
  "light": {
    "hue": {
      "gray": {
        "100": "#0b1630",
        "200": "#1a2540",
        "300": "#4a5678",
        "400": "#8c97b5",
        "500": "#c9d0e3",
