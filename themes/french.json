        "500": "#97c3ec",
        "600": "#b8d7f5",
        "700": "#d3e6fa",
        "800": "#e6f1fd",
        "900": "#f4f9ff"
      },
      "blue": {
        "100": "#0a2a6b",
        "200": "#1f4fb5",
        "300": "#2f63d1",
        "400": "#5a85e0",
        "500": "#8fb0ec",
        "600": "#b3cbf5",
        "700": "#d3e2fa",
        "800": "#e6effd",
        "900": "#f4f8ff"
